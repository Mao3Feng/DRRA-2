epoch <config> {
  #cell 0_0
  linear route0r < load_r_2_0
  linear load_r_2_0 == load_w_2_0
  linear load_r_2_0 + 1 == read_io_3_0

  #cell 1_0
  linear route0r < route1wr
  linear route1wr < write_filter
  linear read_io_3_0 + 1 == write_filter
  #cell 2_0
  linear route0r < route2w
}



epoch <rb0> {
  #cell 0_0
  linear load_r_2_1 == load_w_2_1
  linear load_r_2_1 + 1 == read_io_3_1

  linear read_io_3_1 + 7 == dpu.e0[0]
  linear read_io_3_1.e0[1][0] + 7 == dpu.e0[26]

  #cell 1_0
  linear swb == dpu

  linear read_io_3_1 + 1 == write_rf4
  linear write_rf4 + 2 == write_rf5
  linear write_rf5 + 2 == write_rf6
  linear read_io_3_1.e0[1][0] + 1 == write_rf4.e0[1][0]

  linear write_rf6 + 1 == read_rf3
  linear read_rf3 == read_rf4
  linear read_rf4 + 3 == read_rf5
  linear read_rf5 + 3 == read_rf6

  linear read_rf3 + 1 == dpu

  linear dpu.e0[1] == write_rf7
  linear write_rf7.e0[0][25] + 1 == read_rf7
  linear write_rf7.e0[1][25] + 1 == read_rf7.e0[1][0]

  #cell 2_0
  linear read_rf7 + 1 == write_io_2_1

  linear output_r_3_1 == output_w_3_1
  linear write_io_2_1.e0[25][1] + 1 == output_r_3_1.e0[51]
}