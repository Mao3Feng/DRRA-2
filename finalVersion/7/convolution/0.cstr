  linear write_rf7.e0[1][51] + 1 == read_rf7.e0[1][0]

  #cell 2_0
  linear read_rf7 + 1 == write_io_2_1
  linear output_r_3_1 == output_w_3_1
  linear write_io_2_1.e0[13][3] + 1 == output_r_3_1.e0[55]
}



epoch <rb1> {
  #cell 0_0
  linear load_r_2_1_t == load_w_2_1_t
  linear load_r_2_1_t + 1 == read_io_3_1_t
  linear read_io_3_1_t + 11 == dpu_t.e0[0][0]
